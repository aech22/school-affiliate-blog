---
import BaseLayout from './BaseLayout.astro';
import Jsonld from '../components/Jsonld.astro';
import { categoryBySlug, genderBySlug } from '../data/taxonomy';

interface Product {
  rank?: number | null;
  name: string;
  price?: number | null;
  image?: string | null;
  url: string;
  shop?: string | null;
  reviewAverage?: number | null;
  reviewCount?: number | null;
  priceBand?: string | null;
  pros?: string[] | null;
  cons?: string | null;
  target?: string | null;
}
interface Data {
  title: string;
  description?: string | null;
  date: Date;
  updated?: Date | null;
  category?: string | null;
  categorySlug?: string | null;
  gender?: 'men' | 'women' | 'unisex' | null;
  intro?: string | null;
  outro?: string | null;
  products?: Product[] | null;
  noindex?: boolean | null;
}
const { data } = Astro.props as { data: Data };
const products = data.products ?? [];
const cat = categoryBySlug(data.categorySlug);
const gender = genderBySlug(data.gender ?? cat?.gender);
const dateStr = data.date.toISOString().slice(0, 10).replace(/-/g, '.');
const updatedStr = (data.updated ?? data.date).toISOString().slice(0, 10).replace(/-/g, '.');
const yen = (n?: number | null) => (n == null ? '' : '¥' + n.toLocaleString('ja-JP'));
const rankStyle = (r?: number | null) =>
  r === 1 ? 'bg-amber-400 text-white'
  : r === 2 ? 'bg-slate-400 text-white'
  : r === 3 ? 'bg-orange-300 text-white'
  : 'bg-brand-100 text-brand-600';
const clip = (s: string, n: number) => (s.length > n ? s.slice(0, n) + '…' : s);
const REL = 'nofollow sponsored noopener';
const ogImage = products[0]?.image ?? undefined;

const breadcrumbs = [{ name: 'ホーム', url: '/' }];
if (gender) breadcrumbs.push({ name: gender.label, url: `/${gender.slug}/` });
if (cat) breadcrumbs.push({ name: cat.label, url: `/categories/${cat.slug}/` });
breadcrumbs.push({ name: data.title, url: Astro.url.pathname });

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: data.title,
  numberOfItems: products.length,
  itemListElement: products.map((p, i) => ({
    '@type': 'ListItem',
    position: (p.rank ?? i + 1),
    name: p.name,
    ...(p.image ? { image: p.image } : {}),
    url: p.url,
  })),
};
---
<BaseLayout
  title={`${data.title}｜ガジェナビ`}
  description={data.description ?? undefined}
  noindex={data.noindex ?? false}
  ogImage={ogImage}
  ogType="article"
  publishedTime={data.date.toISOString()}
  modifiedTime={(data.updated ?? data.date).toISOString()}
  breadcrumbs={breadcrumbs}
>
  <main class="mx-auto max-w-3xl px-4 py-8">
    <Jsonld data={itemListLd} />
    <nav class="flex flex-wrap items-center gap-1 text-xs font-medium text-ink/40" aria-label="パンくず">
      <a href={import.meta.env.BASE_URL} class="hover:text-brand-600">ホーム</a>
      {gender && (<><span>／</span><a href={`${import.meta.env.BASE_URL}${gender.slug}/`} class="hover:text-brand-600">{gender.label}</a></>)}
      {cat && (<><span>／</span><a href={`${import.meta.env.BASE_URL}categories/${cat.slug}/`} class="hover:text-brand-600">{cat.label}</a></>)}
    </nav>

    <div class="mt-3 flex flex-wrap items-center gap-2">
      {cat && (
        <a href={`${import.meta.env.BASE_URL}categories/${cat.slug}/`} class="rounded-full bg-brand-100 px-3 py-1 text-xs font-black text-brand-600 hover:bg-brand-200">
          {cat.emoji} {cat.label}
        </a>
      )}
      <span class="text-xs font-medium text-ink/40">公開 {dateStr}・更新 {updatedStr}・{products.length}商品を比較</span>
    </div>

    <h1 class="mt-3 text-2xl font-black leading-tight sm:text-3xl">{data.title}</h1>

    <p class="mt-4 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm leading-relaxed text-amber-800">
      本記事はアフィリエイト広告（楽天アフィリエイト）を含みます。価格・レビューは掲載時点のもので、変動する場合があります。
    </p>

    {data.intro && <p class="mt-6 text-[15px] leading-relaxed text-ink/80">{data.intro}</p>}

    <div class="mt-8 space-y-6">
      {
        products.map((p) => (
          <article class="overflow-hidden rounded-2xl border border-black/5 bg-white shadow-sm transition hover:shadow-md">
            <div class="flex flex-col sm:flex-row">
              <div class="relative shrink-0 bg-brand-50 sm:w-56">
                <span class={`absolute left-3 top-3 grid h-9 w-9 place-items-center rounded-full text-sm font-black shadow ${rankStyle(p.rank)}`}>
                  {p.rank}
                </span>
                {p.image ? (
                  <img src={p.image} alt={p.name} loading="lazy" width="400" height="400" data-pin-description={`${p.name}｜${data.title}`} class="mx-auto h-56 w-full object-contain p-5 sm:h-full" />
                ) : (
                  <div class="grid h-56 place-items-center text-sm text-brand-500/40">no image</div>
                )}
              </div>

              <div class="flex flex-1 flex-col p-5">
                <h2 class="text-base font-bold leading-snug">
                  <a href={p.url} target="_blank" rel={REL} class="hover:text-brand-600">{p.name}</a>
                </h2>
                {p.shop && <p class="mt-1 text-xs text-ink/40">{p.shop}</p>}

                {p.reviewAverage != null && (
                  <div class="mt-2 flex items-center gap-1.5 text-sm">
                    <span class="stars"><span style={`width:${((p.reviewAverage / 5) * 100).toFixed(1)}%`} /></span>
                    <b class="text-ink/80">{p.reviewAverage.toFixed(2)}</b>
                    {p.reviewCount != null && (<span class="text-xs text-ink/40">（{p.reviewCount.toLocaleString('ja-JP')}件）</span>)}
                  </div>
                )}

                <div class="mt-2 flex flex-wrap items-baseline gap-2">
                  <span class="text-2xl font-black text-brand-600">{yen(p.price)}</span>
                  {p.priceBand && <span class="rounded bg-brand-50 px-2 py-0.5 text-xs font-black text-brand-600">{p.priceBand}</span>}
                </div>

                {p.pros && p.pros.length > 0 && (
                  <ul class="mt-3 space-y-1.5">
                    {p.pros.map((pro) => (
                      <li class="flex gap-2 text-sm text-ink/80"><span class="mt-0.5 font-black text-green-500">✓</span><span>{pro}</span></li>
                    ))}
                  </ul>
                )}

                {p.cons && <p class="mt-3 text-sm leading-relaxed text-ink/55"><span class="font-bold text-ink/70">気になる点：</span>{p.cons}</p>}
                {p.target && <p class="mt-1 text-sm leading-relaxed text-ink/55"><span class="font-bold text-ink/70">向いている人：</span>{p.target}</p>}

                <a href={p.url} target="_blank" rel={REL} class="mt-4 inline-flex items-center justify-center gap-2 rounded-xl bg-brand-500 px-5 py-3 text-sm font-black text-white shadow-sm transition hover:bg-brand-600 hover:shadow">
                  楽天で「{clip(p.name, 14)}」を見る →
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    {
      products.length > 1 && (
        <section class="mt-12">
          <h2 class="mb-3 flex items-center gap-2 text-lg font-black"><span class="h-5 w-1.5 rounded bg-brand-500" />比較まとめ</h2>
          <div class="overflow-x-auto rounded-xl border border-black/5">
            <table class="w-full min-w-[440px] border-collapse bg-white text-sm">
              <thead>
                <tr class="bg-brand-50 text-ink/70">
                  <th class="p-3 text-left font-black">商品</th>
                  <th class="p-3 text-right font-black">価格</th>
                  <th class="p-3 text-center font-black">評価</th>
                  <th class="p-3 text-left font-black">価格帯</th>
                </tr>
              </thead>
              <tbody>
                {products.map((p) => (
                  <tr class="border-t border-black/5">
                    <td class="p-3">
                      <a href={p.url} target="_blank" rel={REL} class="font-medium text-brand-600 hover:underline">
                        {p.rank}位. {clip(p.name, 22)}
                      </a>
                    </td>
                    <td class="p-3 text-right font-bold whitespace-nowrap">{yen(p.price)}</td>
                    <td class="p-3 text-center whitespace-nowrap">{p.reviewAverage != null ? `★${p.reviewAverage.toFixed(2)}` : '—'}</td>
                    <td class="p-3 text-ink/60">{p.priceBand ?? '—'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )
    }

    {
      data.outro && (
        <section class="mt-12 rounded-2xl bg-brand-50 p-6">
          <h2 class="mb-2 text-lg font-black text-ink">まとめ</h2>
          <p class="text-[15px] leading-relaxed text-ink/80">{data.outro}</p>
        </section>
      )
    }

    {cat && (
      <p class="mt-10 text-sm">
        <a href={`${import.meta.env.BASE_URL}categories/${cat.slug}/`} class="font-bold text-brand-600 hover:underline">
          → 「{cat.label}」の他の記事を見る
        </a>
      </p>
    )}
    <p class="mt-3">
      <a href={import.meta.env.BASE_URL} class="inline-flex items-center gap-1 text-sm font-black text-brand-600 hover:underline">← 記事一覧へ戻る</a>
    </p>
  </main>
</BaseLayout>

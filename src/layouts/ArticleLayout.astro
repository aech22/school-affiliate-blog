---
import BaseLayout from './BaseLayout.astro';
import Jsonld from '../components/Jsonld.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Sidebar from '../components/Sidebar.astro';
import ShiftyPromo from '../components/ShiftyPromo.astro';
import ProductMention from '../components/ProductMention.astro';
import { categoryBySlug } from '../data/taxonomy';
import { SITE_NAME } from '../consts';
import servicesData from '../data/services.json';
import productsData from '../data/products.json';

interface ServiceRef {
  id: string;
  rank?: number | null;
  pros?: string[] | null;
  cons?: string | null;
  target?: string | null;
  highlight?: string | null;
}
interface Data {
  title: string;
  description?: string | null;
  date: Date;
  updated?: Date | null;
  category?: string | null;
  categorySlug?: string | null;
  type?: 'compare' | 'guide' | 'problem' | 'essay' | null;
  products?: string[] | null;
  intro?: string | null;
  outro?: string | null;
  services?: ServiceRef[] | null;
  noindex?: boolean | null;
}
const { data } = Astro.props as { data: Data };

// services.json（事実）を id で引き、記事側の講評をマージした表示用オブジェクトを作る。
// id が services.json に無いものはスキップ。target は記事側優先、pros/cons/highlight は記事側を使う。
const registry = servicesData.services;
const resolved = (data.services ?? [])
  .map((ref) => {
    const fact = registry.find((f) => f.id === ref.id);
    if (!fact) return null;
    return {
      id: fact.id,
      name: fact.name,
      tags: fact.tags,
      priceNote: fact.priceNote,
      officialUrl: fact.officialUrl,
      affiliateUrl: fact.affiliateUrl,
      approved: fact.approved,
      rank: ref.rank ?? null,
      pros: ref.pros ?? [],
      cons: ref.cons ?? null,
      target: ref.target ?? fact.target ?? null,
      highlight: ref.highlight ?? null,
    };
  })
  .filter((s): s is NonNullable<typeof s> => s !== null)
  .sort((a, b) => (a.rank ?? 999) - (b.rank ?? 999));

// products.json（事実）を id で引く。記事側は id を並べるだけで、事実は持たない。
const productRegistry = productsData.products;
const resolvedProducts = (data.products ?? [])
  .map((id) => productRegistry.find((p) => p.id === id))
  .filter((p): p is NonNullable<typeof p> => p != null);

const cat = categoryBySlug(data.categorySlug);
const dateStr = data.date.toISOString().slice(0, 10).replace(/-/g, '.');
const updatedStr = (data.updated ?? data.date).toISOString().slice(0, 10).replace(/-/g, '.');
const clip = (s: string, n: number) => (s.length > n ? s.slice(0, n) + '…' : s);
const hrefOf = (s: { approved?: boolean | null; affiliateUrl?: string | null; officialUrl: string }) =>
  s.approved && s.affiliateUrl ? (s.affiliateUrl as string) : s.officialUrl;
const relOf = (s: { approved?: boolean | null; affiliateUrl?: string | null }) =>
  s.approved && s.affiliateUrl ? 'sponsored noopener' : 'nofollow noopener';

const breadcrumbs = [{ name: 'ホーム', url: '/' }];
if (cat) breadcrumbs.push({ name: cat.label, url: `/categories/${cat.slug}/` });
breadcrumbs.push({ name: data.title, url: Astro.url.pathname });

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: data.title,
  numberOfItems: resolved.length,
  itemListElement: resolved.map((s, i) => ({
    '@type': 'ListItem',
    position: (s.rank ?? i + 1),
    name: s.name,
    url: hrefOf(s),
  })),
};
---
<BaseLayout
  title={`${data.title}｜${SITE_NAME}`}
  description={data.description ?? undefined}
  noindex={data.noindex ?? false}
  ogType="article"
  publishedTime={data.date.toISOString()}
  modifiedTime={(data.updated ?? data.date).toISOString()}
  breadcrumbs={breadcrumbs}
>
  <div class="mx-auto max-w-5xl px-4 py-8 lg:grid lg:grid-cols-[minmax(0,1fr)_280px] lg:gap-10 lg:items-start">
  <main class="min-w-0">
    <Jsonld data={itemListLd} />
    <nav class="flex flex-wrap items-center gap-1 text-xs text-ink/40" aria-label="パンくず">
      <a href={import.meta.env.BASE_URL} class="transition-colors duration-150 hover:text-brand-700">ホーム</a>
      {cat && (<><span>／</span><a href={`${import.meta.env.BASE_URL}categories/${cat.slug}/`} class="transition-colors duration-150 hover:text-brand-700">{cat.label}</a></>)}
    </nav>

    <p class="mt-6 text-xs text-ink/45">
      {cat && (
        <a href={`${import.meta.env.BASE_URL}categories/${cat.slug}/`} class="transition-colors duration-150 hover:text-brand-700">{cat.label}</a>
      )}
      <span>　公開 {dateStr}</span>
      {updatedStr !== dateStr && <span>　更新 {updatedStr}</span>}
      {data.type === 'compare' && resolved.length > 1 && <span>　{resolved.length}件を比較</span>}
    </p>

    <h1 class="mt-2 font-serif text-2xl font-semibold leading-snug text-ink sm:text-[1.75rem]">{data.title}</h1>

    <p class="mt-4 border-y border-ink/10 py-3 text-xs leading-relaxed text-ink/50">
      この記事には広告（アフィリエイトリンク）を含みます。掲載している料金・内容は掲載時点のもので、変動する場合があります。最新の情報は各社の公式サイトをご確認ください。
    </p>

    {data.intro && <p class="mt-8 leading-loose text-ink/80">{data.intro}</p>}

    <div class="prose prose-slate mt-8 max-w-none leading-loose prose-headings:font-semibold prose-h2:mt-12 prose-h2:text-xl prose-h3:text-lg prose-a:text-brand-700 prose-a:decoration-brand-700/30">
      <slot />
    </div>

    {resolvedProducts.map((p) => <ProductMention product={p} />)}

    <div class="mt-10 space-y-8">
      {resolved.map((s) => <ServiceCard service={s} />)}
    </div>

    {
      data.type === 'compare' && resolved.length > 1 && (
        <section class="mt-14">
          <h2 class="border-b border-ink pb-2 font-serif text-xl font-semibold text-ink">比較まとめ</h2>
          <div class="mt-4 overflow-x-auto">
            <table class="w-full min-w-[440px] border-collapse text-sm">
              <thead>
                <tr class="border-b border-ink/20 text-left text-xs text-ink/50">
                  <th class="py-2 pr-3 font-medium">サービス</th>
                  <th class="py-2 pr-3 font-medium">料金目安</th>
                  <th class="py-2 font-medium">特徴</th>
                </tr>
              </thead>
              <tbody>
                {resolved.map((s) => (
                  <tr class="border-b border-ink/10 align-top">
                    <td class="py-3 pr-3">
                      <a href={hrefOf(s)} target="_blank" rel={relOf(s)} class="text-brand-700 underline decoration-brand-700/30 underline-offset-4 hover:decoration-brand-700">
                        {s.rank != null ? `${s.rank}. ` : ''}{clip(s.name, 22)}
                      </a>
                    </td>
                    <td class="py-3 pr-3 text-ink/70">{s.priceNote ?? '—'}</td>
                    <td class="py-3 text-ink/60">{(s.tags ?? []).slice(0, 2).join('・') || '—'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )
    }

    {
      data.outro && (
        <section class="mt-14 border-t border-ink pt-5">
          <h2 class="font-serif text-xl font-semibold text-ink">おわりに</h2>
          <p class="mt-3 leading-loose text-ink/80">{data.outro}</p>
        </section>
      )
    }

    <ShiftyPromo />

    <nav class="mt-12 space-y-2 text-sm">
      {cat && (
        <p>
          <a href={`${import.meta.env.BASE_URL}categories/${cat.slug}/`} class="text-brand-700 underline decoration-brand-700/30 underline-offset-4 hover:decoration-brand-700">
            「{cat.label}」の他の記事を読む
          </a>
        </p>
      )}
      <p>
        <a href={import.meta.env.BASE_URL} class="text-brand-700 underline decoration-brand-700/30 underline-offset-4 hover:decoration-brand-700">← 記事一覧へ戻る</a>
      </p>
    </nav>
  </main>
    <Sidebar />
  </div>
</BaseLayout>

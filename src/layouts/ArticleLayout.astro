---
import BaseLayout from './BaseLayout.astro';
import Jsonld from '../components/Jsonld.astro';
import ServiceCard from '../components/ServiceCard.astro';
import AdBanner from '../components/AdBanner.astro';
import { categoryBySlug } from '../data/taxonomy';
import { SITE_NAME } from '../consts';
import servicesData from '../data/services.json';

interface ServiceRef {
  id: string;
  rank?: number | null;
  pros?: string[] | null;
  cons?: string | null;
  target?: string | null;
  highlight?: string | null;
}
interface Data {
  title: string;
  description?: string | null;
  date: Date;
  updated?: Date | null;
  category?: string | null;
  categorySlug?: string | null;
  intro?: string | null;
  outro?: string | null;
  services?: ServiceRef[] | null;
  noindex?: boolean | null;
}
const { data } = Astro.props as { data: Data };

// services.json（事実）を id で引き、記事側の講評をマージした表示用オブジェクトを作る。
// id が services.json に無いものはスキップ。target は記事側優先、pros/cons/highlight は記事側を使う。
const registry = servicesData.services;
const resolved = (data.services ?? [])
  .map((ref) => {
    const fact = registry.find((f) => f.id === ref.id);
    if (!fact) return null;
    return {
      id: fact.id,
      name: fact.name,
      tags: fact.tags,
      priceNote: fact.priceNote,
      officialUrl: fact.officialUrl,
      affiliateUrl: fact.affiliateUrl,
      approved: fact.approved,
      rank: ref.rank ?? null,
      pros: ref.pros ?? [],
      cons: ref.cons ?? null,
      target: ref.target ?? fact.target ?? null,
      highlight: ref.highlight ?? null,
    };
  })
  .filter((s): s is NonNullable<typeof s> => s !== null)
  .sort((a, b) => (a.rank ?? 999) - (b.rank ?? 999));

const cat = categoryBySlug(data.categorySlug);
const dateStr = data.date.toISOString().slice(0, 10).replace(/-/g, '.');
const updatedStr = (data.updated ?? data.date).toISOString().slice(0, 10).replace(/-/g, '.');
const clip = (s: string, n: number) => (s.length > n ? s.slice(0, n) + '…' : s);
const hrefOf = (s: { approved?: boolean | null; affiliateUrl?: string | null; officialUrl: string }) =>
  s.approved && s.affiliateUrl ? (s.affiliateUrl as string) : s.officialUrl;
const relOf = (s: { approved?: boolean | null; affiliateUrl?: string | null }) =>
  s.approved && s.affiliateUrl ? 'sponsored noopener' : 'nofollow noopener';

const breadcrumbs = [{ name: 'ホーム', url: '/' }];
if (cat) breadcrumbs.push({ name: cat.label, url: `/categories/${cat.slug}/` });
breadcrumbs.push({ name: data.title, url: Astro.url.pathname });

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: data.title,
  numberOfItems: resolved.length,
  itemListElement: resolved.map((s, i) => ({
    '@type': 'ListItem',
    position: (s.rank ?? i + 1),
    name: s.name,
    url: hrefOf(s),
  })),
};
---
<BaseLayout
  title={`${data.title}｜${SITE_NAME}`}
  description={data.description ?? undefined}
  noindex={data.noindex ?? false}
  ogType="article"
  publishedTime={data.date.toISOString()}
  modifiedTime={(data.updated ?? data.date).toISOString()}
  breadcrumbs={breadcrumbs}
>
  <main class="mx-auto max-w-3xl px-4 py-8">
    <Jsonld data={itemListLd} />
    <nav class="flex flex-wrap items-center gap-1 text-xs font-medium text-ink/40" aria-label="パンくず">
      <a href={import.meta.env.BASE_URL} class="hover:text-brand-600">ホーム</a>
      {cat && (<><span>／</span><a href={`${import.meta.env.BASE_URL}categories/${cat.slug}/`} class="hover:text-brand-600">{cat.label}</a></>)}
    </nav>

    <div class="mt-3 flex flex-wrap items-center gap-2">
      {cat && (
        <a href={`${import.meta.env.BASE_URL}categories/${cat.slug}/`} class="rounded-full bg-brand-100 px-3 py-1 text-xs font-black text-brand-600 hover:bg-brand-200">
          {cat.emoji} {cat.label}
        </a>
      )}
      <span class="text-xs font-medium text-ink/40">公開 {dateStr}・更新 {updatedStr}・{resolved.length}校を比較</span>
    </div>

    <h1 class="mt-3 text-2xl font-black leading-tight sm:text-3xl">{data.title}</h1>

    <p class="mt-4 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm leading-relaxed text-amber-800">
      本記事はアフィリエイト広告を含みます。掲載の料金・コース内容は掲載時点のもので、変動する場合があります。最新情報は各スクールの公式サイトをご確認ください。
    </p>

    {data.intro && <p class="mt-6 text-[15px] leading-relaxed text-ink/80">{data.intro}</p>}

    <div class="mt-8 space-y-6">
      {resolved.map((s) => <ServiceCard service={s} />)}
    </div>

    {
      resolved.length > 1 && (
        <section class="mt-12">
          <h2 class="mb-3 flex items-center gap-2 text-lg font-black"><span class="h-5 w-1.5 rounded bg-brand-500" />比較まとめ</h2>
          <div class="overflow-x-auto rounded-xl border border-black/5">
            <table class="w-full min-w-[440px] border-collapse bg-white text-sm">
              <thead>
                <tr class="bg-brand-50 text-ink/70">
                  <th class="p-3 text-left font-black">スクール</th>
                  <th class="p-3 text-left font-black">料金目安</th>
                  <th class="p-3 text-left font-black">特徴</th>
                </tr>
              </thead>
              <tbody>
                {resolved.map((s) => (
                  <tr class="border-t border-black/5">
                    <td class="p-3">
                      <a href={hrefOf(s)} target="_blank" rel={relOf(s)} class="font-medium text-brand-600 hover:underline">
                        {s.rank != null ? `${s.rank}位. ` : ''}{clip(s.name, 22)}
                      </a>
                    </td>
                    <td class="p-3 text-ink/70">{s.priceNote ?? '—'}</td>
                    <td class="p-3 text-ink/60">{(s.tags ?? []).slice(0, 2).join('・') || '—'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )
    }

    {
      data.outro && (
        <section class="mt-12 rounded-2xl bg-brand-50 p-6">
          <h2 class="mb-2 text-lg font-black text-ink">まとめ</h2>
          <p class="text-[15px] leading-relaxed text-ink/80">{data.outro}</p>
        </section>
      )
    }

    <AdBanner />

    {cat && (
      <p class="mt-10 text-sm">
        <a href={`${import.meta.env.BASE_URL}categories/${cat.slug}/`} class="font-bold text-brand-600 hover:underline">
          → 「{cat.label}」の他の記事を見る
        </a>
      </p>
    )}
    <p class="mt-3">
      <a href={import.meta.env.BASE_URL} class="inline-flex items-center gap-1 text-sm font-black text-brand-600 hover:underline">← 記事一覧へ戻る</a>
    </p>
  </main>
</BaseLayout>

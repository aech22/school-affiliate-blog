---
import '../styles/global.css';
import Jsonld from '../components/Jsonld.astro';
import { CATEGORIES } from '../data/taxonomy';
import { SITE_NAME, SITE_TAGLINE, GA_MEASUREMENT_ID, PINTEREST_VERIFY, TWITTER_SITE } from '../consts';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  ogImage?: string;
  ogType?: string;
  publishedTime?: string;
  modifiedTime?: string;
  breadcrumbs?: { name: string; url: string }[];
}
const {
  title,
  description = 'プログラミング・資格・語学のスクールと転職サービスを、料金・特徴・サポートで比較するメディア。教育訓練給付金など公的な学び支援制度の使い方も解説します。',
  noindex = false,
  ogImage,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  breadcrumbs,
} = Astro.props;

const site = Astro.site ?? new URL('https://aech22.github.io/school-affiliate-blog');
const canonical = new URL(Astro.url.pathname, site);
// 既定はブランドOGP(/ogp.png)。記事など個別に指定があればそれを使う。
const ogImg = new URL(ogImage ?? '/ogp.png', site).toString();
const year = new Date().getFullYear();

// サイト共通の構造化データ
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE_NAME,
  url: site.toString(),
  description: 'プログラミング・資格・語学のスクールと転職サービスを、料金・特徴・サポートで比較するメディア。教育訓練給付金など公的な学び支援制度の使い方も解説します。',
};
const siteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  url: site.toString(),
  inLanguage: 'ja',
};
const breadcrumbLd = breadcrumbs && breadcrumbs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((b, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: b.name,
        item: new URL(b.url, site).toString(),
      })),
    }
  : null;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}todge-favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${import.meta.env.BASE_URL}favicon-32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${import.meta.env.BASE_URL}favicon-16.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${import.meta.env.BASE_URL}favicon-180.png`} />
    <meta name="theme-color" content="#101216" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    {PINTEREST_VERIFY && <meta name="p:domain_verify" content={PINTEREST_VERIFY} />}
    <link rel="canonical" href={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&display=swap"
      rel="stylesheet"
    />
    <!-- OGP -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImg && <meta property="og:image" content={ogImg} />}
    {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content={ogImg ? 'summary_large_image' : 'summary'} />
    {TWITTER_SITE && <meta name="twitter:site" content={TWITTER_SITE} />}
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImg && <meta name="twitter:image" content={ogImg} />}
    <Jsonld data={orgLd} />
    <Jsonld data={siteLd} />
    {breadcrumbLd && <Jsonld data={breadcrumbLd} />}
    {
      GA_MEASUREMENT_ID && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`} is:inline />
          <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${GA_MEASUREMENT_ID}');`} />
        </>
      )
    }
  </head>
  <body class="min-h-screen font-sans text-ink antialiased">
    <header class="sticky top-0 z-30 border-b border-black/5 bg-cream/85 backdrop-blur">
      <div class="mx-auto flex max-w-5xl items-center justify-between gap-3 px-4 py-3">
        <a href={import.meta.env.BASE_URL} class="flex shrink-0 items-center gap-2">
          <span class="grid h-8 w-8 place-items-center rounded-lg bg-brand-500 font-black text-white shadow-sm">{SITE_NAME.charAt(0)}</span>
          <span class="text-lg font-black tracking-tight">{SITE_NAME}<span class="text-brand-500">.</span></span>
        </a>
        <nav class="flex items-center gap-1 overflow-x-auto text-sm font-bold text-ink/60 sm:gap-2">
          {CATEGORIES.map((c) => (
            <a
              href={`${import.meta.env.BASE_URL}categories/${c.slug}/`}
              class="whitespace-nowrap rounded-full px-3 py-1.5 transition hover:bg-brand-50 hover:text-brand-600"
            >
              {c.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <slot />

    <footer class="mt-20 border-t border-black/5 bg-white">
      <div class="mx-auto max-w-5xl px-4 py-8 text-sm text-ink/55">
        <p class="text-base font-black text-ink/75">{SITE_NAME}<span class="text-brand-500">.</span></p>
        <p class="mt-1">プログラミングスクールを料金・特徴・サポートで比較して紹介しています。</p>
        <nav class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-xs font-bold text-ink/60">
          {CATEGORIES.map((c) => (
            <a href={`${import.meta.env.BASE_URL}categories/${c.slug}/`} class="hover:text-brand-600">{c.label}</a>
          ))}
          <a href={import.meta.env.BASE_URL} class="hover:text-brand-600">記事一覧</a>
          <a href={`${import.meta.env.BASE_URL}about/`} class="hover:text-brand-600">運営者情報</a>
          <a href={`${import.meta.env.BASE_URL}privacy/`} class="hover:text-brand-600">プライバシーポリシー</a>
        </nav>
        <p class="mt-4 text-xs leading-relaxed text-ink/45">
          当サイトはアフィリエイト広告を利用しています。掲載の料金・コース内容は変動する場合があります。最新情報は各スクールの公式サイトをご確認ください。
        </p>
        <p class="mt-3 text-xs text-ink/35">© {year} {SITE_NAME}</p>
      </div>
    </footer>
  </body>
</html>

---
import '../styles/global.css';
import Jsonld from '../components/Jsonld.astro';
import { CATEGORIES } from '../data/taxonomy';
import { SITE_NAME, SITE_TAGLINE, GA_MEASUREMENT_ID, PINTEREST_VERIFY, TWITTER_SITE, SEARCH_CONSOLE_VERIFY } from '../consts';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  ogImage?: string;
  ogType?: string;
  publishedTime?: string;
  modifiedTime?: string;
  breadcrumbs?: { name: string; url: string }[];
}
const {
  title,
  description = '働きながら学び直す人のためのブログ。講座・資格・転職・語学のサービスと、教育訓練給付金のような公的な学び支援制度について調べたことをまとめています。',
  noindex = false,
  ogImage,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  breadcrumbs,
} = Astro.props;

const site = Astro.site ?? new URL('https://aech22.github.io/school-affiliate-blog');
const canonical = new URL(Astro.url.pathname, site);
// 既定はブランドOGP(/ogp.png)。記事など個別に指定があればそれを使う。
const ogImg = new URL(ogImage ?? '/ogp.png', site).toString();
const year = new Date().getFullYear();

// サイト共通の構造化データ
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE_NAME,
  url: site.toString(),
  description: '働きながら学び直す人のためのブログ。講座・資格・転職・語学のサービスと、教育訓練給付金のような公的な学び支援制度について調べたことをまとめています。',
};
const siteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  url: site.toString(),
  inLanguage: 'ja',
};
const breadcrumbLd = breadcrumbs && breadcrumbs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((b, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: b.name,
        item: new URL(b.url, site).toString(),
      })),
    }
  : null;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}todge-favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${import.meta.env.BASE_URL}favicon-32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${import.meta.env.BASE_URL}favicon-16.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${import.meta.env.BASE_URL}favicon-180.png`} />
    <meta name="theme-color" content="#101216" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    {PINTEREST_VERIFY && <meta name="p:domain_verify" content={PINTEREST_VERIFY} />}
    {SEARCH_CONSOLE_VERIFY && <meta name="google-site-verification" content={SEARCH_CONSOLE_VERIFY} />}
    <link rel="canonical" href={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Noto+Serif+JP:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <!-- OGP -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImg && <meta property="og:image" content={ogImg} />}
    {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content={ogImg ? 'summary_large_image' : 'summary'} />
    {TWITTER_SITE && <meta name="twitter:site" content={TWITTER_SITE} />}
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImg && <meta name="twitter:image" content={ogImg} />}
    <Jsonld data={orgLd} />
    <Jsonld data={siteLd} />
    {breadcrumbLd && <Jsonld data={breadcrumbLd} />}
    {
      GA_MEASUREMENT_ID && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`} is:inline />
          <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${GA_MEASUREMENT_ID}');`} />
        </>
      )
    }
  </head>
  <body class="min-h-screen font-sans text-[15px] leading-relaxed text-ink antialiased">
    <header class="border-b border-ink/10">
      <div class="mx-auto flex max-w-5xl flex-wrap items-baseline gap-x-6 gap-y-2 px-4 py-5">
        <a href={import.meta.env.BASE_URL} class="font-serif text-xl font-semibold tracking-tight text-ink">{SITE_NAME}</a>
        <nav class="flex flex-wrap items-baseline gap-x-4 gap-y-1 text-sm text-ink/60">
          {CATEGORIES.map((c) => (
            <a
              href={`${import.meta.env.BASE_URL}categories/${c.slug}/`}
              class="whitespace-nowrap transition-colors duration-150 hover:text-brand-700"
            >
              {c.label}
            </a>
          ))}
          <a href={`${import.meta.env.BASE_URL}about/`} class="whitespace-nowrap transition-colors duration-150 hover:text-brand-700">このブログについて</a>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="mt-24 border-t border-ink/10">
      <div class="mx-auto max-w-5xl px-4 py-10 text-sm text-ink/55">
        <p class="font-serif text-base font-semibold text-ink/80">{SITE_NAME}</p>
        <p class="mt-1 leading-relaxed">{SITE_TAGLINE}</p>
        <nav class="mt-5 flex flex-wrap gap-x-4 gap-y-2 text-xs text-ink/60">
          {CATEGORIES.map((c) => (
            <a href={`${import.meta.env.BASE_URL}categories/${c.slug}/`} class="transition-colors duration-150 hover:text-brand-700">{c.label}</a>
          ))}
          <a href={import.meta.env.BASE_URL} class="transition-colors duration-150 hover:text-brand-700">記事一覧</a>
          <a href={`${import.meta.env.BASE_URL}about/`} class="transition-colors duration-150 hover:text-brand-700">このブログについて</a>
          <a href={`${import.meta.env.BASE_URL}privacy/`} class="transition-colors duration-150 hover:text-brand-700">プライバシーポリシー</a>
        </nav>
        <p class="mt-5 text-xs leading-relaxed text-ink/45">
          当サイトはアフィリエイト広告を利用しています。掲載しているサービスの料金・内容は変動する場合があります。最新の情報は各社の公式サイトをご確認ください。
        </p>
        <p class="mt-3 text-xs text-ink/35">© {year} {SITE_NAME}</p>
      </div>
    </footer>
  </body>
</html>

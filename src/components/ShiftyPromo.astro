---
// Shifty（自社アプリ・飲食店向けシフト管理）への導線カード。
// 国内5サイトで内容は完全に同一。1つ直したら5つとも直すこと。
// 正本: Obsidian「Projects/アフィリエイト/AFFILIATE.md」の "Shifty 導線のルール"。
//
// ・アフィリリンクではなく自社サービスなので rel="sponsored"/"nofollow" は付けない（dofollow）。
// ・ただし広告であることに変わりはないので、ステマ規制対応で「PR」ラベルを明示する。
// ・設置は記事末（ArticleLayout）とサイドバー（Sidebar）の2箇所のみ。footer には置かない
//   （全ページ反復の同一アンカーリンクは SEO 上のリスクになるため意図的に外している）。
import { SHIFTY_UTM_SOURCE } from '../consts';

interface Props {
  variant?: 'article' | 'sidebar';
}
const { variant = 'article' } = Astro.props as Props;

// 流入元をサイトごとに分離して計測できるようにする。
const href = `https://shiftyshifty.app/?utm_source=${SHIFTY_UTM_SOURCE}&utm_medium=affiliate_site&utm_campaign=cross_promo`;
---
{
  variant === 'sidebar' ? (
    <section class="border-t border-ink/10 pt-5">
      <p class="mb-2 text-[11px] tracking-wide text-ink/35">PR · このブログの運営者が作っています</p>
      <p class="font-serif text-sm font-semibold leading-snug text-ink">シフト管理アプリ Shifty</p>
      <p class="mt-2 text-xs leading-relaxed text-ink/60">
        飲食店の希望シフト集めから、シフト表の Excel 出力まで。スタッフは送られてきたURLを開くだけで提出でき、会員登録もアプリのインストールも要りません。
      </p>
      <p class="mt-3">
        <a
          href={href}
          target="_blank"
          rel="noopener"
          class="text-xs text-brand-700 underline decoration-brand-700/30 underline-offset-4 hover:decoration-brand-700"
        >
          無料ではじめる
        </a>
      </p>
    </section>
  ) : (
    <aside class="mt-14 border-t border-ink/10 pt-6">
      <p class="text-[11px] tracking-wide text-ink/35">PR · このブログの運営者が作っています</p>
      <p class="mt-2 font-serif text-lg font-semibold leading-snug text-ink">シフトの希望集め、まだ LINE と Excel の往復でやっていませんか？</p>
      <p class="mt-3 text-sm leading-relaxed text-ink/70">
        Shifty は飲食店向けのシフト管理アプリです。スタッフは送られてきたURLを開いて希望を入れるだけで、会員登録もアプリのインストールも要りません。店長は集まった希望をそのままシフト表として Excel に出力できます。無料プランから使えます。
      </p>
      <p class="mt-4">
        <a
          href={href}
          target="_blank"
          rel="noopener"
          class="inline-block rounded-md border border-ink/20 px-4 py-2 text-sm text-ink/80 transition-colors duration-150 hover:border-brand-700 hover:text-brand-700"
        >
          Shifty を見る
        </a>
      </p>
    </aside>
  )
}

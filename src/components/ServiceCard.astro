---
// スクール1件分のカード。services.json の事実 ＋ 記事側の講評(rank/pros/cons/target/highlight)を
// マージ済みの単一オブジェクトを受け取る。承認済み(approved)かつ affiliateUrl があればアフィリンク、
// それ以外は公式サイトへ rel=nofollow で送る。
interface Service {
  id: string;
  name: string;
  tags?: string[] | null;
  priceNote?: string | null;
  target?: string | null;
  officialUrl: string;
  affiliateUrl?: string | null;
  approved?: boolean | null;
  rank?: number | null;
  pros?: string[] | null;
  cons?: string | null;
  highlight?: string | null;
}
const { service } = Astro.props as { service: Service };
const s = service;

const useAff = !!(s.approved && s.affiliateUrl);
const href = useAff ? (s.affiliateUrl as string) : s.officialUrl;
const rel = useAff ? 'sponsored noopener' : 'nofollow noopener';

const rankStyle = (r?: number | null) =>
  r === 1 ? 'bg-amber-400 text-white'
  : r === 2 ? 'bg-slate-400 text-white'
  : r === 3 ? 'bg-orange-300 text-white'
  : 'bg-brand-100 text-brand-600';

const tags = s.tags ?? [];
const pros = s.pros ?? [];
---
<article class="overflow-hidden rounded-2xl border border-black/5 bg-white shadow-sm transition hover:shadow-md">
  <div class="flex flex-col p-5">
    <div class="flex items-start gap-3">
      {s.rank != null && (
        <span class={`grid h-9 w-9 shrink-0 place-items-center rounded-full text-sm font-black shadow ${rankStyle(s.rank)}`}>
          {s.rank}
        </span>
      )}
      <div class="min-w-0 flex-1">
        {s.highlight && (
          <span class="mb-1 inline-block rounded bg-brand-50 px-2 py-0.5 text-xs font-black text-brand-600">{s.highlight}</span>
        )}
        <h2 class="text-base font-bold leading-snug sm:text-lg">
          <a href={href} target="_blank" rel={rel} class="hover:text-brand-600">{s.name}</a>
        </h2>
      </div>
    </div>

    {tags.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-1.5">
        {tags.map((t) => (
          <span class="rounded-full bg-brand-50 px-2.5 py-0.5 text-xs font-bold text-brand-600">{t}</span>
        ))}
      </div>
    )}

    {s.priceNote && (
      <p class="mt-3 text-sm text-ink/70"><span class="font-bold text-ink/80">料金目安：</span>{s.priceNote}</p>
    )}

    {pros.length > 0 && (
      <ul class="mt-3 space-y-1.5">
        {pros.map((pro) => (
          <li class="flex gap-2 text-sm text-ink/80"><span class="mt-0.5 font-black text-green-500">✓</span><span>{pro}</span></li>
        ))}
      </ul>
    )}

    {s.cons && <p class="mt-3 text-sm leading-relaxed text-ink/55"><span class="font-bold text-ink/70">気になる点：</span>{s.cons}</p>}
    {s.target && <p class="mt-1 text-sm leading-relaxed text-ink/55"><span class="font-bold text-ink/70">向いている人：</span>{s.target}</p>}

    <a href={href} target="_blank" rel={rel} class="mt-4 inline-flex items-center justify-center gap-2 rounded-xl bg-brand-500 px-5 py-3 text-sm font-black text-white shadow-sm transition hover:bg-brand-600 hover:shadow">
      公式サイトを見る →
    </a>
  </div>
</article>

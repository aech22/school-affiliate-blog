---
// スクール1件分のカード。services.json の事実 ＋ 記事側の講評(rank/pros/cons/target/highlight)を
// マージ済みの単一オブジェクトを受け取る。承認済み(approved)かつ affiliateUrl があればアフィリンク、
// それ以外は公式サイトへ rel=nofollow で送る。
interface Service {
  id: string;
  name: string;
  tags?: string[] | null;
  priceNote?: string | null;
  target?: string | null;
  officialUrl: string;
  affiliateUrl?: string | null;
  approved?: boolean | null;
  rank?: number | null;
  pros?: string[] | null;
  cons?: string | null;
  highlight?: string | null;
}
const { service } = Astro.props as { service: Service };
const s = service;

const useAff = !!(s.approved && s.affiliateUrl);
const href = useAff ? (s.affiliateUrl as string) : s.officialUrl;
const rel = useAff ? 'sponsored noopener' : 'nofollow noopener';

const tags = s.tags ?? [];
const pros = s.pros ?? [];
---
<article class="border-l-2 border-ink/15 pl-5">
  <h2 class="font-serif text-lg font-semibold leading-snug text-ink">
    {s.rank != null && <span class="mr-1.5 text-ink/40">{s.rank}.</span>}
    <a href={href} target="_blank" rel={rel} class="underline decoration-ink/20 underline-offset-4 transition-colors duration-150 hover:text-brand-700 hover:decoration-brand-700">{s.name}</a>
  </h2>

  {s.highlight && <p class="mt-1 text-sm text-ink/60">{s.highlight}</p>}

  {tags.length > 0 && (
    <p class="mt-2 text-xs text-ink/45">{tags.join('・')}</p>
  )}

  {s.priceNote && (
    <p class="mt-3 text-sm text-ink/70"><span class="text-ink/50">料金目安　</span>{s.priceNote}</p>
  )}

  {pros.length > 0 && (
    <ul class="mt-3 space-y-1.5 text-sm text-ink/80">
      {pros.map((pro) => (
        <li class="flex gap-2"><span class="text-ink/30">—</span><span class="leading-relaxed">{pro}</span></li>
      ))}
    </ul>
  )}

  {s.cons && <p class="mt-3 text-sm leading-relaxed text-ink/60"><span class="text-ink/45">気になる点　</span>{s.cons}</p>}
  {s.target && <p class="mt-1.5 text-sm leading-relaxed text-ink/60"><span class="text-ink/45">向いている人　</span>{s.target}</p>}

  <p class="mt-4">
    <a href={href} target="_blank" rel={rel} class="inline-block rounded-md bg-brand-600 px-4 py-2 text-sm font-medium text-white transition-colors duration-150 hover:bg-brand-700">
      公式サイトを見る
    </a>
  </p>
</article>

---
import type { CollectionEntry } from 'astro:content';
import { categoryBySlug } from '../data/taxonomy';

interface Props { article: CollectionEntry<'articles'>; }
const { article } = Astro.props;
const d = article.data;
const products = d.products ?? [];
const thumb = products[0]?.image;
const cat = categoryBySlug(d.categorySlug);
const fmtDate = (x: Date) => x.toISOString().slice(0, 10).replace(/-/g, '.');
// フィルタ用の data 属性（クライアント側でトグル表示する）
const gender = d.gender ?? cat?.gender ?? 'unisex';
---
<a
  href={`${import.meta.env.BASE_URL}articles/${article.id}/`}
  class="article-card group flex flex-col overflow-hidden rounded-2xl border border-black/5 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-xl"
  data-gender={gender}
  data-category={d.categorySlug ?? ''}
>
  <div class="relative aspect-[16/9] overflow-hidden bg-brand-50">
    {thumb ? (
      <img
        src={thumb}
        alt={d.title}
        loading="lazy"
        width="400"
        height="400"
        data-pin-description={`${d.title}｜ガジェナビ`}
        class="h-full w-full object-contain p-4 transition duration-300 group-hover:scale-105"
      />
    ) : (
      <div class="grid h-full place-items-center text-sm text-brand-500/40">no image</div>
    )}
    {cat && (
      <span class="absolute left-3 top-3 rounded-full bg-white/90 px-3 py-1 text-xs font-black text-brand-600 shadow-sm">
        {cat.emoji} {cat.label}
      </span>
    )}
  </div>
  <div class="flex flex-1 flex-col p-5">
    <p class="text-xs font-bold text-ink/40">{fmtDate(d.date)}・{products.length}商品を比較</p>
    <h3 class="mt-1 font-bold leading-snug transition group-hover:text-brand-600">{d.title}</h3>
    {d.description && <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-ink/60">{d.description}</p>}
    <span class="mt-4 inline-flex items-center gap-1 text-sm font-black text-brand-600">
      続きを読む <span class="transition group-hover:translate-x-1">→</span>
    </span>
  </div>
</a>

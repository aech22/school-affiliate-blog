---
import type { CollectionEntry } from 'astro:content';
import { categoryBySlug } from '../data/taxonomy';

interface Props { article: CollectionEntry<'articles'>; }
const { article } = Astro.props;
const d = article.data;
const cat = categoryBySlug(d.categorySlug);
const fmtDate = (x: Date) => x.toISOString().slice(0, 10).replace(/-/g, '.');
---
<a
  href={`${import.meta.env.BASE_URL}articles/${article.id}/`}
  class="article-card group flex flex-col overflow-hidden rounded-2xl border border-black/5 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-xl"
  data-category={d.categorySlug ?? ''}
>
  <div class="flex flex-1 flex-col p-5">
    <div class="flex items-center gap-2">
      {cat && (
        <span class="rounded-full bg-brand-50 px-3 py-1 text-xs font-black text-brand-600">
          {cat.emoji} {cat.label}
        </span>
      )}
      <span class="text-xs font-bold text-ink/40">{fmtDate(d.date)}・{(d.services?.length ?? 0)}校を比較</span>
    </div>
    <h3 class="mt-3 text-lg font-bold leading-snug transition group-hover:text-brand-600">{d.title}</h3>
    {d.description && <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-ink/60">{d.description}</p>}
    <span class="mt-4 inline-flex items-center gap-1 text-sm font-black text-brand-600">
      続きを読む <span class="transition group-hover:translate-x-1">→</span>
    </span>
  </div>
</a>

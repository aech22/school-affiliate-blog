---
import { getCollection } from 'astro:content';
import { CATEGORIES } from '../data/taxonomy';
import ShiftyPromo from './ShiftyPromo.astro';

const recent = (await getCollection('articles'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);

// A8.net お名前.com（独自ドメイン取得）120×600 スカイスクレイパー。規約どおり原文のまま。& のJSXパース回避で set:html。
const skyscraperHtml = `<a href="https://px.a8.net/svt/ejp?a8mat=4B9X1D+6NXPKI+50+2HGLCX" rel="nofollow sponsored" target="_blank"><img border="0" width="120" height="600" alt="お名前.com" src="https://www21.a8.net/svt/bgt?aid=260803201403&wid=001&eno=01&mid=s00000000018015026000&mc=1"></a><img border="0" width="1" height="1" src="https://www12.a8.net/0.gif?a8mat=4B9X1D+6NXPKI+50+2HGLCX" alt="">`;

// A8.net ココナラ（スキルマーケット）120×60。学習者→副業/スキル販売の文脈。規約どおり原文のまま。
const coconalaHtml = `<a href="https://px.a8.net/svt/ejp?a8mat=4B9X1D+97114I+2PEO+64RJ5" rel="nofollow sponsored" target="_blank"><img border="0" width="120" height="60" alt="ココナラ" src="https://www29.a8.net/svt/bgt?aid=260803201556&wid=001&eno=01&mid=s00000012624001030000&mc=1"></a><img border="0" width="1" height="1" src="https://www15.a8.net/0.gif?a8mat=4B9X1D+97114I+2PEO+64RJ5" alt="">`;

// A8.net 社内SE転職ナビ（IT/社内SE転職）テキストリンク。学習→エンジニア転職の文脈。規約どおり原文のまま（狭いサイドバーに収まるようテキストリンクを採用）。
const seNaviHtml = `<a href="https://px.a8.net/svt/ejp?a8mat=4B9X1F+3MZDV6+3IZO+I4FNM" rel="nofollow sponsored" target="_blank" class="font-bold text-brand-600 hover:underline">最近、仕事楽しめてますか？！社内SEへ転職するなら【社内SE転職ナビ】</a><img border="0" width="1" height="1" src="https://www17.a8.net/0.gif?a8mat=4B9X1F+3MZDV6+3IZO+I4FNM" alt="">`;

// A8.net ユメキャリ転職エージェント（一般転職）テキストリンク。規約どおり原文のまま。
const yumecariHtml = `<a href="https://px.a8.net/svt/ejp?a8mat=4B9X1F+4T95TE+5PWS+BWVTE" rel="nofollow sponsored" target="_blank" class="font-bold text-brand-600 hover:underline">大手企業の現役面接官が運営する転職エージェント【ユメキャリAgent】</a><img border="0" width="1" height="1" src="https://www13.a8.net/0.gif?a8mat=4B9X1F+4T95TE+5PWS+BWVTE" alt="">`;

// A8.net 動画教材エディター養成コース（動画編集講座）テキストリンク。規約どおり原文のまま。
const videoEditorHtml = `<a href="https://px.a8.net/svt/ejp?a8mat=4B9X1F+3L731U+4V0U+ZQFQA" rel="nofollow sponsored" target="_blank" class="font-bold text-brand-600 hover:underline">【動画教材エディター養成コース】</a><img border="0" width="1" height="1" src="https://www13.a8.net/0.gif?a8mat=4B9X1F+3L731U+4V0U+ZQFQA" alt="">`;

// A8.net 代理店ドットコム（副業・独立の案件を一括資料請求）テキストリンク。規約どおり原文のまま。
const dairitenHtml = `<a href="https://px.a8.net/svt/ejp?a8mat=4B9X1D+9ERNZM+5WDA+5YJRM" rel="nofollow sponsored" target="_blank" class="font-bold text-brand-600 hover:underline">独立・副業の第一歩を力強くサポート！代理店ビジネス情報を一括比較【代理店募集.com】</a><img border="0" width="1" height="1" src="https://www11.a8.net/0.gif?a8mat=4B9X1D+9ERNZM+5WDA+5YJRM" alt="">`;

// A8.net fan.salon（LINEでオンラインサロン/スクールを開設）テキストリンク。規約どおり原文のまま。
const fanSalonHtml = `<a href="https://px.a8.net/svt/ejp?a8mat=4B9X1F+AWCOFM+5FAU+5YJRM" rel="nofollow sponsored" target="_blank" class="font-bold text-brand-600 hover:underline">LINEでオンランサロン【fan.salon】</a><img border="0" width="1" height="1" src="https://www19.a8.net/0.gif?a8mat=4B9X1F+AWCOFM+5FAU+5YJRM" alt="">`;
---
<aside class="space-y-6">
  <section class="rounded-2xl border border-black/5 bg-white p-5">
    <h2 class="mb-3 flex items-center gap-2 text-sm font-black"><span class="h-4 w-1.5 rounded bg-brand-500" />カテゴリ</h2>
    <ul class="space-y-1">
      {CATEGORIES.map((c) => (
        <li>
          <a href={`${import.meta.env.BASE_URL}categories/${c.slug}/`} class="flex items-center gap-2 rounded-lg px-2 py-1.5 text-sm text-ink/70 transition hover:bg-brand-50 hover:text-brand-600">
            <span>{c.emoji}</span>{c.label}
          </a>
        </li>
      ))}
    </ul>
  </section>

  {recent.length > 0 && (
    <section class="rounded-2xl border border-black/5 bg-white p-5">
      <h2 class="mb-3 flex items-center gap-2 text-sm font-black"><span class="h-4 w-1.5 rounded bg-brand-500" />新着記事</h2>
      <ul class="space-y-3">
        {recent.map((a) => (
          <li>
            <a href={`${import.meta.env.BASE_URL}articles/${a.id}/`} class="block text-sm font-medium leading-snug text-ink/80 transition hover:text-brand-600">{a.data.title}</a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="rounded-2xl border border-black/5 bg-white p-4">
    <p class="mb-2 text-[11px] font-black tracking-wide text-ink/35">広告</p>
    <div class="overflow-x-auto"><div style="min-width:120px" set:html={skyscraperHtml} /></div>
  </section>

  <section class="rounded-2xl border border-black/5 bg-white p-4">
    <p class="mb-2 text-[11px] font-black tracking-wide text-ink/35">広告 · 学んだスキルを副業に</p>
    <p class="mb-3 text-xs leading-relaxed text-ink/60">身につけたスキルは副業でも活かせます。イラスト・Web制作・相談などを売買できるスキルマーケット。</p>
    <div set:html={coconalaHtml} />
  </section>

  <section class="rounded-2xl border border-black/5 bg-white p-4">
    <p class="mb-2 text-[11px] font-black tracking-wide text-ink/35">広告 · エンジニア転職</p>
    <p class="mb-2 text-xs leading-relaxed text-ink/60">学習の先にエンジニア就職を目指すなら。客先常駐なしの社内SE求人に特化した転職支援です。</p>
    <p class="text-sm leading-snug" set:html={seNaviHtml} />
  </section>

  <section class="rounded-2xl border border-black/5 bg-white p-4">
    <p class="mb-2 text-[11px] font-black tracking-wide text-ink/35">広告 · 転職エージェント</p>
    <p class="mb-2 text-xs leading-relaxed text-ink/60">大手企業の現役面接官が運営。書類添削・面接対策に強みのある転職支援です。</p>
    <p class="text-sm leading-snug" set:html={yumecariHtml} />
  </section>

  <section class="rounded-2xl border border-black/5 bg-white p-4">
    <p class="mb-2 text-[11px] font-black tracking-wide text-ink/35">広告 · 動画編集で稼ぐ</p>
    <p class="mb-2 text-xs leading-relaxed text-ink/60">動画編集のスキルで収入を得たい方へ。資格認定・顧客紹介つきの養成コースです。</p>
    <p class="text-sm leading-snug" set:html={videoEditorHtml} />
  </section>

  <section class="rounded-2xl border border-black/5 bg-white p-4">
    <p class="mb-2 text-[11px] font-black tracking-wide text-ink/35">広告 · 副業・独立</p>
    <p class="mb-2 text-xs leading-relaxed text-ink/60">雇われる以外の選択肢を探すなら。代理店・フランチャイズの募集案件を一括で比較できます。</p>
    <p class="mb-3 text-sm leading-snug" set:html={dairitenHtml} />
    <p class="mb-2 text-xs leading-relaxed text-ink/60">自分の発信をファン向けの会員制サービスにするなら、LINE上でサロンを開設できるサービスもあります。</p>
    <p class="text-sm leading-snug" set:html={fanSalonHtml} />
  </section>
  <ShiftyPromo variant="sidebar" />

</aside>

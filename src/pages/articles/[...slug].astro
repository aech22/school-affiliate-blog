---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { readingMinutes } from '../../utils/reading';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  // ノートの No. は「何本目の記事か」。公開日の古い順に1から数える。
  const order = [...articles].sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf()).map((a) => a.id);
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article, seq: order.indexOf(article.id) + 1 },
  }));
}

const { article, seq } = Astro.props;
const { Content, headings } = await render(article);
---
<ArticleLayout data={article.data} slug={article.id} seq={seq} minutes={readingMinutes(article)} headings={headings}>
  <Content />
</ArticleLayout>

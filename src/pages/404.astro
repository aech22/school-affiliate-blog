---
// 404。GitHub Pages は dist/404.html をそのまま使う。
// リンク切れで来た人を行き止まりにせず、話題の入口へ戻せるようにする。
import BaseLayout from '../layouts/BaseLayout.astro';
import { CATEGORIES } from '../data/taxonomy';
import { SITE_NAME } from '../consts';
---
<BaseLayout title={`ページが見つかりません｜${SITE_NAME}`} noindex={true}>
  <main class="mx-auto max-w-3xl px-4 py-20">
    <h1 class="font-serif text-2xl font-semibold leading-snug text-ink">ページが見つかりませんでした</h1>
    <p class="mt-4 leading-relaxed text-ink/70">
      お探しのページは移動したか、URL が変わった可能性があります。話題から探し直してみてください。
    </p>
    <ul class="mt-8 space-y-2 text-sm">
      {CATEGORIES.map((c) => (
        <li>
          <a href={`${import.meta.env.BASE_URL}categories/${c.slug}/`} class="text-brand-700 underline decoration-brand-700/30 underline-offset-4 hover:decoration-brand-700">{c.label}</a>
          <span class="text-ink/55">　{c.blurb}</span>
        </li>
      ))}
    </ul>
    <p class="mt-8">
      <a href={import.meta.env.BASE_URL} class="text-sm text-brand-700 underline decoration-brand-700/30 underline-offset-4 hover:decoration-brand-700">← 記事一覧へ戻る</a>
    </p>
  </main>
</BaseLayout>

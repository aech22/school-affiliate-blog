---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Sidebar from '../../components/Sidebar.astro';
import Jsonld from '../../components/Jsonld.astro';
import { CATEGORIES } from '../../data/taxonomy';
import { SITE_NAME } from '../../consts';

export async function getStaticPaths() {
  const all = await getCollection('articles');
  return CATEGORIES.map((c) => ({
    params: { slug: c.slug },
    props: {
      cat: c,
      articles: all
        .filter((a) => a.data.categorySlug === c.slug)
        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
    },
  }));
}

const { cat, articles } = Astro.props;
// <title> は label ではなく metaTitle を使う。ナビ用の短い名前より、読者が実際に検索する語を出す。
const title = `${cat.metaTitle}の記事｜${SITE_NAME}`;
const others = CATEGORIES.filter((c) => c.slug !== cat.slug);
const description = cat.blurb;
const breadcrumbs = [
  { name: 'ホーム', url: '/' },
  { name: cat.label, url: `/categories/${cat.slug}/` },
];
const site = Astro.site ?? new URL('https://aech22.github.io/school-affiliate-blog');
const listLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  url: new URL(`/categories/${cat.slug}/`, site).toString(),
  hasPart: articles.map((a) => ({
    '@type': 'Article',
    headline: a.data.title,
    url: new URL(`/articles/${a.id}/`, site).toString(),
  })),
};
---
<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs}>
  <Jsonld data={listLd} />
  <div class="mx-auto max-w-5xl px-4 py-8 lg:grid lg:grid-cols-[minmax(0,1fr)_280px] lg:gap-8 lg:items-start">
  <main class="min-w-0">
    <nav class="flex flex-wrap items-center gap-1 text-xs font-medium text-ink/40" aria-label="パンくず">
      <a href={import.meta.env.BASE_URL} class="transition-colors duration-150 hover:text-brand-700">ホーム</a>
      <span>／</span><span class="text-ink/60">{cat.label}</span>
    </nav>

    <header class="mt-6 border-b border-ink pb-5">
      <h1 class="font-serif text-2xl font-semibold leading-snug text-ink sm:text-[1.75rem]">{cat.label}</h1>
      <p class="mt-3 max-w-2xl leading-relaxed text-ink/70">{cat.intro}</p>
    </header>

    {articles.length === 0 ? (
      <p class="mt-10 text-ink/50">この話題の記事はまだありません。</p>
    ) : (
      <div class="mt-2">
        {articles.map((a) => <ArticleCard article={a} />)}
      </div>
    )}

    <nav class="mt-14 border-t border-ink/10 pt-5" aria-label="他の話題">
      <h2 class="font-serif text-base font-semibold text-ink">他の話題</h2>
      <ul class="mt-3 space-y-2 text-sm">
        {others.map((c) => (
          <li>
            <a href={`${import.meta.env.BASE_URL}categories/${c.slug}/`} class="text-brand-700 underline decoration-brand-700/30 underline-offset-4 hover:decoration-brand-700">{c.label}</a>
            <span class="text-ink/55">　{c.blurb}</span>
          </li>
        ))}
      </ul>
    </nav>

    <p class="mt-10">
      <a href={import.meta.env.BASE_URL} class="text-sm text-brand-700 underline decoration-brand-700/30 underline-offset-4 hover:decoration-brand-700">← 記事一覧へ戻る</a>
    </p>
  </main>
    <Sidebar />
  </div>
</BaseLayout>

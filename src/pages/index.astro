---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Jsonld from '../components/Jsonld.astro';
import { CATEGORIES } from '../data/taxonomy';
import { SITE_NAME } from '../consts';

const articles = (await getCollection('articles')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
// 記事が存在するカテゴリだけ絞り込みに出す
const usedCats = new Set(articles.map((a) => a.data.categorySlug).filter(Boolean));
const catChips = CATEGORIES.filter((c) => usedCats.has(c.slug));

const site = Astro.site ?? new URL('https://aech22.github.io/school-affiliate-blog');
const listLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${SITE_NAME} の記事一覧`,
  numberOfItems: articles.length,
  itemListElement: articles.map((a, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: a.data.title,
    url: new URL(`/articles/${a.id}/`, site).toString(),
  })),
};
---
<BaseLayout
  title={`${SITE_NAME}｜働きながら学び直す人のための、講座・給付金・転職のブログ`}
  description="働きながら学び直す社会人のためのブログ。プログラミングスクールや動画編集講座の比較、教育訓練給付金など公的な学び支援制度の解説、転職エージェントの使い分け、在宅で学ぶための道具について調べたことをまとめています。"
>
  <Jsonld data={listLd} />

  <!-- 書き出し。ヒーローバナーは置かない（読み物として文章から始める） -->
  <section class="mx-auto max-w-3xl px-4 pt-12 sm:pt-16">
    <h1 class="font-serif text-2xl font-semibold leading-snug text-ink sm:text-[1.75rem]">
      働きながら、学び直している人のためのブログです。
    </h1>
    <div class="mt-5 space-y-4 text-ink/75">
      <p>
        サービス業の現場で働きながら、講座や資格で学び直しています。仕事を変えたい、増やしたいと思って調べたこと——講座の費用、教育訓練給付金のような公的な制度、転職サービスの使い分け、在宅で働くための道具——を、次に同じことを調べる人のためにここへ置いています。
      </p>
      <p class="text-sm text-ink/55">
        紹介しているサービスの料金や内容は、各社が公開している情報をもとにしています。広告を含む記事にはその旨を明記しています。
      </p>
    </div>
    <p class="mt-6 flex flex-wrap items-baseline gap-x-4 gap-y-1 text-sm text-ink/55">
      <span class="text-xs text-ink/40">話題から読む</span>
      {CATEGORIES.map((c) => (
        <a href={`${import.meta.env.BASE_URL}categories/${c.slug}/`} class="underline decoration-ink/20 underline-offset-4 transition-colors duration-150 hover:text-brand-700 hover:decoration-brand-700">{c.label}</a>
      ))}
    </p>
  </section>

  <!-- 記事一覧 -->
  <main class="mx-auto max-w-3xl px-4 pb-4 pt-14">
    <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-b border-ink pb-2">
      <h2 class="font-serif text-lg font-semibold text-ink">記事（{articles.length}）</h2>
      <div id="cat-chips" class="flex flex-wrap gap-x-3 gap-y-1 text-xs text-ink/50">
        <button type="button" data-category="all" class="chip-btn is-active transition-colors duration-150 hover:text-brand-700">すべて</button>
        {catChips.map((c) => (
          <button type="button" data-category={c.slug} class="chip-btn transition-colors duration-150 hover:text-brand-700">{c.label}</button>
        ))}
      </div>
    </div>

    <div id="article-grid">
      {articles.map((a) => <ArticleCard article={a} />)}
    </div>
    <p id="empty-msg" class="mt-6 hidden text-sm text-ink/50">該当する記事がありません。</p>
  </main>

  <style>
    .chip-btn.is-active { color: var(--color-ink); text-decoration: underline; text-underline-offset: 4px; }
  </style>

  <script is:inline>
    (function () {
      let csel = 'all';
      const grid = document.getElementById('article-grid');
      const cards = grid ? Array.from(grid.querySelectorAll('.article-card')) : [];
      const empty = document.getElementById('empty-msg');

      function apply() {
        let shown = 0;
        cards.forEach((el) => {
          const c = el.getAttribute('data-category');
          const ok = (csel === 'all' || c === csel);
          el.style.display = ok ? '' : 'none';
          if (ok) shown++;
        });
        if (empty) empty.classList.toggle('hidden', shown !== 0);
      }
      const box = document.getElementById('cat-chips');
      if (box) {
        box.addEventListener('click', (e) => {
          const btn = e.target.closest('button[data-category]');
          if (!btn) return;
          box.querySelectorAll('button').forEach((b) => b.classList.remove('is-active'));
          btn.classList.add('is-active');
          csel = btn.getAttribute('data-category');
          apply();
        });
      }
    })();
  </script>
</BaseLayout>

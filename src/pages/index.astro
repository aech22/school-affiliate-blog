---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Jsonld from '../components/Jsonld.astro';
import { activeCategories } from '../data/taxonomy';
import { STAGES } from '../utils/reading';
import { SITE_NAME } from '../consts';

const articles = (await getCollection('articles')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
// 索引に出すのは記事があるカテゴリと段階だけ（0本の選択肢は置かない）。
const cats = activeCategories(articles.map((a) => a.data.categorySlug ?? ''));
const stages = STAGES.filter((s) => articles.some((a) => a.data.type === s.key));
const countBy = (pred: (a: (typeof articles)[number]) => boolean) => articles.filter(pred).length;

// ノート上部の No. と Date は実データ。No. は記事の本数、Date はいちばん新しい公開日または更新日。
const lastTouched = articles
  .map((a) => (a.data.updated ?? a.data.date).valueOf())
  .reduce((x, y) => Math.max(x, y), 0);
const fmt = (t: number) => new Date(t).toISOString().slice(0, 10).replace(/-/g, '.');

const site = Astro.site ?? new URL('https://aech22.github.io/school-affiliate-blog');
const listLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${SITE_NAME} の記事一覧`,
  numberOfItems: articles.length,
  itemListElement: articles.map((a, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: a.data.title,
    url: new URL(`/articles/${a.id}/`, site).toString(),
  })),
};
---
<BaseLayout
  title={`${SITE_NAME}｜働きながら学び直す人のための、講座・給付金・転職のブログ`}
  description="働きながら学び直す社会人のためのブログ。プログラミングスクールや動画編集講座の比較、教育訓練給付金など公的な学び支援制度の解説、転職エージェントの使い分け、在宅で学ぶための道具について調べたことをまとめています。"
>
  <Jsonld data={listLd} />

  <!-- ページ全体を1冊のノートに見立てる。左の欄外とオレンジの余白線は、書き出しから記事の最後まで1本で続く。
       ヒーローバナーは置かない（読み物として文章から始める・2026-09-05 の決めごと）。 -->
  <div class="mx-auto max-w-5xl px-4 pt-8 sm:pt-12">
    <p class="note-head" aria-label={`記事 ${articles.length} 本・最終更新 ${fmt(lastTouched)}`}>
      <span>No.<b>{articles.length}</b></span>
      <span>Date<b>{fmt(lastTouched)}</b></span>
    </p>

    <div class="note-rule mt-8 sm:mt-10" style="--margin-w: 8.5rem">
      <section class="note-grid pb-14 sm:pb-20">
        <p class="note-aside is-wide-only pt-3 font-serif text-sm text-ink/50">はじめに</p>
        <div>
          <h1 class="font-serif text-[1.75rem] font-semibold leading-[1.4] tracking-tight text-ink sm:text-[2.5rem] sm:leading-[1.35]">
            働きながら、<br />学び直している人のためのブログです。
          </h1>
          <div class="mt-7 max-w-2xl space-y-4 text-ink/75 sm:text-base">
            <p>
              サービス業の現場で働きながら、講座や資格で学び直しています。仕事を変えたい、増やしたいと思って調べたこと——講座の費用、教育訓練給付金のような公的な制度、転職サービスの使い分け、在宅で働くための道具——を、次に同じことを調べる人のためにここへ置いています。
            </p>
            <p class="text-sm text-ink/55">
              紹介しているサービスの料金や内容は、各社が公開している情報をもとにしています。広告を含む記事にはその旨を明記しています。
            </p>
          </div>
        </div>
      </section>

      <!-- 索引。話題（カテゴリ）と段階（記事の型）の2軸で、下の記事一覧をその場で絞る。
           各選択肢の数字は「もう一方の軸の選択を保ったまま選んだら何本残るか」で、押す前に0本かどうかが分かる。 -->
      <section id="index" class="note-grid border-t border-ink pt-5 pb-6" aria-labelledby="index-title">
        <h2 id="index-title" class="note-aside pt-1.5 font-serif text-base font-semibold text-ink">索引</h2>
        <div>
          <p class="text-sm text-ink/60">いまの自分に近いものを選ぶと、下の記事がその場で絞られます。</p>
          <div class="mt-4 grid grid-cols-[minmax(0,1fr)] gap-y-2 sm:grid-cols-[3.5rem_minmax(0,1fr)] sm:gap-x-4">
            <p class="pt-2 text-xs text-ink/45" id="axis-cat">話題</p>
            <div class="flex flex-wrap gap-x-5" role="group" aria-labelledby="axis-cat">
              <button type="button" class="idx-btn" data-axis="cat" data-value="all" aria-pressed="true">すべて<span class="n">{articles.length}</span></button>
              {cats.map((c) => (
                <button type="button" class="idx-btn" data-axis="cat" data-value={c.slug} aria-pressed="false">
                  {c.label}<span class="n">{countBy((a) => a.data.categorySlug === c.slug)}</span>
                </button>
              ))}
            </div>
            <p class="pt-2 text-xs text-ink/45" id="axis-stage">段階</p>
            <div>
              <div class="flex flex-wrap gap-x-5" role="group" aria-labelledby="axis-stage">
                <button type="button" class="idx-btn" data-axis="stage" data-value="all" aria-pressed="true">すべて<span class="n">{articles.length}</span></button>
                {stages.map((s) => (
                  <button type="button" class="idx-btn" data-axis="stage" data-value={s.key} aria-pressed="false" title={s.hint}>
                    {s.label}<span class="n">{countBy((a) => a.data.type === s.key)}</span>
                  </button>
                ))}
              </div>
              <p class="mt-1 flex flex-wrap gap-x-4 text-xs leading-relaxed text-ink/45">
                {stages.map((s) => (<span class="whitespace-nowrap">{s.label}＝{s.hint}</span>))}
              </p>
            </div>
          </div>
          <p class="mt-5 text-sm text-ink/60" aria-live="polite">
            {articles.length}本のうち <b id="idx-count" class="font-serif text-base font-semibold tabular-nums text-ink">{articles.length}本</b> を表示しています。
          </p>
        </div>
      </section>

      <main>
        <h2 class="sr-only">記事一覧</h2>
        <div id="article-grid" class="border-t border-ink/10">
          {articles.map((a) => <ArticleCard article={a} />)}
        </div>
        <p id="empty-msg" class="note-grid mt-6 hidden text-sm text-ink/50"><span>該当する記事がありません。</span></p>
      </main>
    </div>
  </div>

  <script is:inline>
    (function () {
      var sel = { cat: 'all', stage: 'all' };
      var grid = document.getElementById('article-grid');
      var cards = grid ? Array.prototype.slice.call(grid.querySelectorAll('.article-card')) : [];
      var buttons = Array.prototype.slice.call(document.querySelectorAll('.idx-btn'));
      var empty = document.getElementById('empty-msg');
      var count = document.getElementById('idx-count');

      function matches(el, s) {
        return (s.cat === 'all' || el.getAttribute('data-category') === s.cat) &&
               (s.stage === 'all' || el.getAttribute('data-stage') === s.stage);
      }
      function apply() {
        var shown = 0;
        cards.forEach(function (el) {
          var ok = matches(el, sel);
          el.style.display = ok ? '' : 'none';
          if (ok) shown++;
        });
        if (empty) empty.classList.toggle('hidden', shown !== 0);
        if (count) count.textContent = shown + '本';
        // 各ボタンの数字を、もう一方の軸の選択を保ったまま押したときの本数に更新する。
        buttons.forEach(function (b) {
          var axis = b.getAttribute('data-axis');
          var trial = { cat: sel.cat, stage: sel.stage };
          trial[axis] = b.getAttribute('data-value');
          var n = cards.filter(function (el) { return matches(el, trial); }).length;
          var badge = b.querySelector('.n');
          if (badge) badge.textContent = n;
          b.setAttribute('data-empty', n === 0 ? 'true' : 'false');
          b.setAttribute('aria-pressed', sel[axis] === b.getAttribute('data-value') ? 'true' : 'false');
        });
      }
      buttons.forEach(function (b) {
        b.addEventListener('click', function () {
          sel[b.getAttribute('data-axis')] = b.getAttribute('data-value');
          apply();
        });
      });
    })();
  </script>
</BaseLayout>

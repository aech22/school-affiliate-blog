---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Jsonld from '../components/Jsonld.astro';
import { GENDERS, CATEGORIES } from '../data/taxonomy';

const articles = (await getCollection('articles')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
// 記事が存在するカテゴリだけチップに出す
const usedCats = new Set(articles.map((a) => a.data.categorySlug).filter(Boolean));
const catChips = CATEGORIES.filter((c) => usedCats.has(c.slug));

const site = Astro.site ?? new URL('https://aech22.github.io/gadget-affiliate-blog');
const listLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'ガジェナビ の比較記事一覧',
  numberOfItems: articles.length,
  itemListElement: articles.map((a, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: a.data.title,
    url: new URL(`/articles/${a.id}/`, site).toString(),
  })),
};
---
<BaseLayout title="ガジェナビ｜写真とレビューで選ぶ おすすめ商品比較">
  <Jsonld data={listLd} />

  <!-- ヒーロー -->
  <section class="bg-gradient-to-br from-brand-500 to-[#ff9a5a] text-white">
    <div class="mx-auto max-w-5xl px-4 py-14 sm:py-20">
      <p class="text-xs font-black tracking-[0.2em] text-white/80">PICK &amp; COMPARE</p>
      <h1 class="mt-3 text-3xl font-black leading-tight sm:text-4xl">
        迷ったら、<br class="sm:hidden" />売れているものから選ぶ。
      </h1>
      <p class="mt-4 max-w-xl leading-relaxed text-white/90">
        楽天で実際に売れている商品を、<b class="font-bold text-white">写真・価格・レビュー</b>と一緒に比較。あなたの「これでいい」を最短で見つけます。
      </p>
    </div>
  </section>

  <!-- カテゴリから探す（内部リンク・SEO） -->
  <section class="mx-auto max-w-5xl px-4 pt-10">
    <h2 class="mb-4 flex items-center gap-2 text-xl font-black"><span class="h-5 w-1.5 rounded bg-brand-500"></span>カテゴリから探す</h2>
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
      {CATEGORIES.map((c) => (
        <a href={`${import.meta.env.BASE_URL}categories/${c.slug}/`} class="flex items-center gap-2 rounded-xl border border-black/5 bg-white px-4 py-3 font-bold shadow-sm transition hover:-translate-y-0.5 hover:text-brand-600 hover:shadow">
          <span class="text-xl">{c.emoji}</span>{c.label}
        </a>
      ))}
    </div>
  </section>

  <!-- 記事一覧 + フィルタ -->
  <main class="mx-auto max-w-5xl px-4 py-12">
    <h2 class="mb-4 flex items-center gap-2 text-xl font-black"><span class="h-5 w-1.5 rounded bg-brand-500"></span>比較記事をしぼり込む</h2>

    <!-- 性別タブ -->
    <div id="gender-tabs" class="flex flex-wrap gap-2">
      <button type="button" data-gender="all" class="filter-btn is-active rounded-full border border-brand-200 px-4 py-1.5 text-sm font-bold transition">すべて</button>
      {GENDERS.map((g) => (
        <button type="button" data-gender={g.slug} class="filter-btn rounded-full border border-brand-200 px-4 py-1.5 text-sm font-bold transition">{g.label}</button>
      ))}
    </div>

    <!-- カテゴリチップ -->
    <div id="cat-chips" class="mt-3 flex flex-wrap gap-2">
      <button type="button" data-category="all" class="chip-btn is-active rounded-full bg-brand-50 px-3 py-1 text-xs font-bold text-ink/70 transition">すべてのカテゴリ</button>
      {catChips.map((c) => (
        <button type="button" data-category={c.slug} class="chip-btn rounded-full bg-brand-50 px-3 py-1 text-xs font-bold text-ink/70 transition">{c.emoji} {c.label}</button>
      ))}
    </div>

    <div id="article-grid" class="mt-6 grid gap-6 sm:grid-cols-2">
      {articles.map((a) => <ArticleCard article={a} />)}
    </div>
    <p id="empty-msg" class="mt-6 hidden text-center text-ink/50">該当する記事がありません。</p>
  </main>

  <style>
    .filter-btn.is-active { background-color: var(--color-brand-500); color: #fff; border-color: var(--color-brand-500); }
    .chip-btn.is-active { background-color: var(--color-brand-500); color: #fff; }
  </style>

  <script is:inline>
    (function () {
      let gsel = 'all', csel = 'all';
      const grid = document.getElementById('article-grid');
      const cards = grid ? Array.from(grid.querySelectorAll('.article-card')) : [];
      const empty = document.getElementById('empty-msg');

      function apply() {
        let shown = 0;
        cards.forEach((el) => {
          const g = el.getAttribute('data-gender');
          const c = el.getAttribute('data-category');
          const ok = (gsel === 'all' || g === gsel) && (csel === 'all' || c === csel);
          el.style.display = ok ? '' : 'none';
          if (ok) shown++;
        });
        if (empty) empty.classList.toggle('hidden', shown !== 0);
      }
      function wire(containerId, attr, set) {
        const box = document.getElementById(containerId);
        if (!box) return;
        box.addEventListener('click', (e) => {
          const btn = e.target.closest('button[' + attr + ']');
          if (!btn) return;
          box.querySelectorAll('button').forEach((b) => b.classList.remove('is-active'));
          btn.classList.add('is-active');
          set(btn.getAttribute(attr));
          apply();
        });
      }
      wire('gender-tabs', 'data-gender', (v) => (gsel = v));
      wire('cat-chips', 'data-category', (v) => (csel = v));
    })();
  </script>
</BaseLayout>
